{
  "name": "@timbre/web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "_comment": "Env lives in one root .env; dotenv-cli loads it for the child process and its workers, which Next would not otherwise see from apps/web.",
    "dev": "dotenv -e ../../.env -- next dev --hostname 127.0.0.1",
    "build": "dotenv -e ../../.env -- next build",
    "start": "dotenv -e ../../.env -- next start",
    "lint": "eslint",
    "test": "node --test \"app/**/*.test.ts\" \"lib/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@timbre/core": "workspace:*",
    "@timbre/providers": "workspace:*",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
