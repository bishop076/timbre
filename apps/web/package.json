{
  "name": "@timbre/web",
  "version": "0.13.0",
  "private": true,
  "scripts": {
    "dev": "dotenv -e ../../.env -- next dev --hostname 127.0.0.1",
    "build": "dotenv -e ../../.env -- next build",
    "start": "dotenv -e ../../.env -- next start",
    "lint": "eslint",
    "test": "node --test \"app/**/*.test.ts\" \"lib/**/*.test.ts\"",
    "typecheck": "next typegen && tsc --noEmit && tsc -p sw"
  },
  "postcss": {
    "plugins": {
      "@tailwindcss/postcss": {}
    }
  },
  "dependencies": {
    "@timbre/core": "workspace:*",
    "@timbre/providers": "workspace:*",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^7"
  }
}
