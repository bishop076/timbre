{
  "name": "@timbre/web",
  "version": "0.16.2",
  "private": true,
  "scripts": {
    "dev": "dotenv -e ../../.env -- next dev --hostname 127.0.0.1",
    "build": "dotenv -e ../../.env -- next build",
    "start": "dotenv -e ../../.env -- next start",
    "lint": "eslint",
    "test": "node --import ./test-hooks.mjs --test \"app/**/*.test.ts\" \"lib/**/*.test.ts\"",
    "typecheck": "next typegen && tsc --noEmit && tsc -p sw",
    "typecheck:fast": "next typegen && tsgo --noEmit && tsgo -p sw"
  },
  "postcss": {
    "plugins": {
      "@tailwindcss/postcss": {}
    }
  },
  "dependencies": {
    "@timbre/core": "workspace:*",
    "@timbre/providers": "workspace:*",
    "next": "16.3.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
