# Copy to .env and fill in. Never commit .env — it holds credentials that can
# read users' music libraries.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/timbre

# Encrypts provider OAuth tokens and users' BYO client secrets at rest.
# Generate: openssl rand -base64 32
# Rotating this makes every stored connection undecryptable — users must reconnect.
TIMBRE_ENCRYPTION_KEY=

# Auth.js session signing key. Generate: npx auth secret
AUTH_SECRET=
# Only needed when the deployed URL cannot be inferred.
# AUTH_URL=https://timbre.example.com

# ---------------------------------------------------------------------------
# YouTube Music sidecar (apps/ytmusic)
# ---------------------------------------------------------------------------

YTMUSIC_SERVICE_URL=http://127.0.0.1:8787
# Must be identical in the web app and the sidecar's environment.
# Generate: openssl rand -hex 32
YTMUSIC_SHARED_SECRET=

# ---------------------------------------------------------------------------
# SoundCloud — the one provider Timbre keys centrally
# ---------------------------------------------------------------------------
# Self-service registration reopened in May 2026 and requires an Artist Pro
# subscription. Register with SoundCloud's CLI (sc-api-auth.mjs) or the web form:
# https://developers.soundcloud.com/docs/api/register-app

SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Email sign-in (optional)
# ---------------------------------------------------------------------------
# Without these, Timbre has no usable sign-in method. For local development,
# Mailpit (http://localhost:8025) works with: smtp://localhost:1025
# EMAIL_FROM must be a fully-qualified address — "timbre@localhost" is rejected.

EMAIL_SERVER=smtp://localhost:1025
EMAIL_FROM=timbre@example.com

# ---------------------------------------------------------------------------
# Spotify and YouTube: intentionally absent
# ---------------------------------------------------------------------------
# Neither has a central client id here, by design.
#
# Spotify caps Development Mode apps at 5 users (Feb 2026) and requires 250k
# monthly active users before granting extended quota — so one shared Timbre
# app could never serve the public. YouTube charges quota to the Google Cloud
# project owning the client id, and the default 10,000 units/day is roughly 200
# track-adds.
#
# Instead each user registers their own app and supplies their own credentials,
# which Timbre encrypts into the `connections` table. See docs/PLAN.md.
